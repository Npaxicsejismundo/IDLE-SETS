# Copy to .env.local for local development, or run:
#   npx vercel link && npx vercel env pull .env.local
# On Vercel, these live in Project → Settings → Environment Variables.
# See README → Registration setup.

# Postgres. Added automatically when you connect a Neon database (Vercel → Storage).
DATABASE_URL=

# Vercel Blob, PRIVATE store. Added automatically when you connect the store.
BLOB_READ_WRITE_TOKEN=

# Password for /admin. Use a long one.
ADMIN_PASSWORD=

# Emails through Resend (optional). Without RESEND_API_KEY no emails are sent.
RESEND_API_KEY=
# Inbox for "new registration" alerts (comma-separated for several).
ADMIN_EMAIL=
# Sender on a domain verified in Resend, e.g. "IDLE Sets <registrations@yourdomain.com>".
# Needed for confirmation emails to registrants.
EMAIL_FROM=

# Optional: your custom domain, used in links, emails and share images.
NEXT_PUBLIC_SITE_URL=
